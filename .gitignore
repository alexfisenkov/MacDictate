# Модели нейросети (не кладем в git)
models/
.macdictate/
*.bin

# Артефакты сборки
build/
build_log*.txt
build_v*_log.txt

# MacOS
.DS_Store

# Игнорируем временные звуки
*.wav
*.m4a
*.txt

# Игнорируем релизы (DMG)
*.dmg

# Локальное хранилище release artifacts.
# В git попадают только манифесты, registry и описания версий.
releases/versions/*/artifacts/*
releases/archive/*/artifacts/*
!releases/versions/*/artifacts/ARTIFACTS.md
!releases/versions/*/artifacts/SHA256SUMS
!releases/archive/*/artifacts/ARTIFACTS.md
!releases/archive/*/artifacts/SHA256SUMS

# Локальные env / secrets
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# Backend runtime data
backend/node_modules/
backend/data/
*.sqlite
*.sqlite-*
npm-debug.log*
